<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>N10STORE — Administração</title>
<style>
:root{color-scheme:dark;--bg:#0b0d12;--panel:#141923;--line:#2a3241;--text:#f4f5f8;--muted:#9aa5b7;--gold:#e9bd68;--red:#ff8585;--green:#73e0a0}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px system-ui,-apple-system,sans-serif;min-height:100vh}
button,input{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}
#loginScreen{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(ellipse at top,#272216,transparent 55%),var(--bg)}
.login-card{width:min(420px,100%);padding:30px;background:var(--panel);border:1px solid var(--line);border-radius:24px;box-shadow:0 25px 80px #0005}
.logo{width:52px;height:52px;border-radius:16px;background:var(--gold);color:#17130b;display:grid;place-items:center;font-weight:950;font-size:17px}
.login-card h1{font-size:25px;margin:22px 0 5px}
.muted{color:var(--muted)}
.login-card p{margin:0 0 24px}
.field{display:grid;gap:7px;margin:16px 0}
label{font-size:13px;color:#c4cad5}
input{width:100%;background:#0c1017;border:1px solid var(--line);border-radius:12px;padding:13px;color:white;outline:none}
input:focus{border-color:var(--gold)}
.btn{border:1px solid var(--line);background:#202633;color:white;padding:11px 15px;border-radius:12px}
.btn.primary{background:var(--gold);color:#17130b;border-color:var(--gold);font-weight:800}
.btn:disabled{opacity:.55;cursor:wait}
.full{width:100%}
.error{color:var(--red);font-size:13px;margin-top:12px;min-height:18px}
.note{font-size:11px;color:#7e899b;margin-top:22px;line-height:1.6}
#app{min-height:100vh}
.sidebar{position:fixed;inset:0 auto 0 0;width:245px;padding:24px 16px;background:#10141c;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:25px}
.brand{display:flex;align-items:center;gap:11px;padding:0 8px}
.brand strong{display:block;letter-spacing:1.5px}
.brand small{color:var(--muted);font-size:10px;letter-spacing:1.5px}
.nav{display:grid;gap:8px}
.nav button{border:1px solid transparent;background:transparent;color:var(--muted);padding:13px;border-radius:12px;text-align:left}
.nav button.active,.nav button:hover{background:#292419;border-color:#5a482a;color:var(--gold)}
.logout{margin-top:auto}
main{margin-left:245px;padding:30px;max-width:1600px}
header{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:25px}
.eyebrow{color:var(--gold);font-size:11px;font-weight:800;letter-spacing:2px}
h1{font-size:clamp(24px,3vw,34px);margin:5px 0}
h2{font-size:17px;margin:0}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:19px;min-width:0}
.card .label{font-size:12px;color:var(--muted)}
.card strong{display:block;font-size:clamp(20px,2.5vw,29px);margin:12px 0;overflow-wrap:anywhere}
.section{margin-top:20px}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}
table{border-collapse:collapse;width:100%;min-width:580px}
th,td{text-align:left;padding:13px;border-bottom:1px solid var(--line);font-size:13px}
th{font-size:10px;color:var(--muted);letter-spacing:1px;text-transform:uppercase}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}
.message{font-size:13px;color:var(--muted);padding:12px 0}
.tag{color:var(--green)}
@media(max-width:1000px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){
 .sidebar{position:relative;width:auto;height:auto;inset:auto;padding:15px;gap:15px;border-right:0;border-bottom:1px solid var(--line)}
 .nav{grid-template-columns:repeat(3,minmax(0,1fr))}
 .nav button{text-align:center;padding:10px 5px;font-size:12px}
 .logout{margin-top:0}
 main{margin:0;padding:20px 14px}
 header{align-items:flex-start}
 .card{padding:14px}
 .grid{gap:9px}
}

.logo{overflow:hidden;background:#fff;border:1px solid #3a3427}
.logo img{display:block;width:100%;height:100%;object-fit:contain}
.brand{min-width:0}
.brand-copy{min-width:0}
.brand strong{font-size:16px;font-weight:900;font-style:italic;letter-spacing:1.5px}
.brand small{display:block;margin-top:4px}
.sidebar{z-index:5}
main{width:auto;min-width:0;margin-right:auto}
header>div{min-width:0}
header .muted{line-height:1.5}
.card,.section,.table-wrap{min-width:0}
button{min-height:42px;transition:background .18s,border-color .18s,transform .18s}
button:active{transform:scale(.98)}
.nav button{font-weight:650}
.nav button.active{box-shadow:inset 3px 0 #e9bd68}
.table-wrap{background:#10141c}
table{min-width:650px}
td{vertical-align:middle}
td img{width:48px;height:58px;object-fit:cover;border-radius:10px}
@media(min-width:701px){
  .sidebar{width:255px;padding:28px 18px}
  main{margin-left:255px;padding:clamp(24px,3vw,44px)}
}
@media(max-width:700px){
  .sidebar{padding:15px 12px;gap:16px}
  .brand{padding:0 4px}
  .brand .logo{width:43px;height:43px;border-radius:13px;flex-shrink:0}
  .brand strong{font-size:15px}
  .nav{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .nav button{min-width:0;white-space:normal;border-radius:12px}
  .logout{width:100%}
  main{margin:0;padding:22px 13px calc(32px + env(safe-area-inset-bottom))}
  header{align-items:flex-start;flex-wrap:wrap;gap:14px}
  header>div{flex:1 1 190px}
  header h1{font-size:27px;overflow-wrap:anywhere}
  #refreshButton{flex-shrink:0}
  .grid{grid-template-columns:1fr;gap:10px}
  .card{padding:16px;border-radius:16px}
  .section-head{align-items:flex-start;flex-wrap:wrap}
  .section-head h2{line-height:1.5}
  .table-wrap{border-radius:12px;max-width:100%}
  th,td{padding:11px 10px}
  .message{overflow-wrap:anywhere;line-height:1.6}
}
@media(max-width:360px){
  main{padding-left:10px;padding-right:10px}
  header h1{font-size:24px}
  .brand strong{letter-spacing:1px}
}

</style>
</head>
<body>
<section id="loginScreen">
  <form class="login-card" id="loginForm">
    <div class="logo"><img src="/assets/produtos/logo.png" alt="N10STORE"></div>
    <h1>Acesso administrativo</h1>
    <p class="muted">Entre na sua conta para continuar.</p>
    <div class="field">
      <label for="username">Usuário</label>
      <input id="username" name="username" autocomplete="username" required>
    </div>
    <div class="field">
      <label for="password">Senha</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn primary full" id="loginButton" type="submit">Entrar no painel</button>
    <div class="error" id="loginError" role="alert"></div>
    <div class="note">Área restrita. A autenticação é verificada pelo servidor.</div>
  </form>
</section>

<div id="app" class="hidden">
  <aside class="sidebar">
    <div class="brand"><div class="logo"><img src="/assets/produtos/logo.png" alt="N10STORE"></div><div class="brand-copy"><strong>N10STORE</strong><small>PAINEL ADMIN</small></div></div>
    <nav class="nav">
      <button class="active" data-view="dashboard">▦ Visão geral</button>
      <button data-view="products">◇ Produtos</button>
    </nav>
    <button class="btn logout" id="logoutButton">Sair da conta</button>
  </aside>

  <main>
    <header>
      <div><div class="eyebrow">N10STORE / ADMINISTRAÇÃO</div><h1 id="pageTitle">Visão geral</h1><div class="muted">Acompanhe sua loja em um só lugar.</div></div>
      <button class="btn" id="refreshButton">↻ Atualizar</button>
    </header>

    <section id="dashboardView">
      <div class="grid">
        
        
        
        <article class="card"><div class="label">Produtos com estoque baixo</div><strong id="lowStock">—</strong><div class="muted">Verifique a reposição</div></article>
      </div>
      <section class="card section">
        <div class="section-head"><h2>Produtos mais vendidos</h2></div>
        <div id="bestSellers" class="message">Carregando dados…</div>
      </section>
    </section>

    <section id="productsView" class="hidden">
      <section class="card">
        <div class="section-head"><h2>Produtos da loja</h2><button class="btn" id="loadProducts">Atualizar lista</button></div>
        <div class="table-wrap"><table><thead><tr><th>Foto</th><th>Produto</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Status</th></tr></thead><tbody id="productRows"><tr><td colspan="6">Carregando…</td></tr></tbody></table></div>
        <div class="message">A edição de produtos pode ser feita no painel administrativo existente.</div>
      </section>
    </section>
    <div class="message" id="appMessage" role="status"></div>
  </main>
</div>

<script>
const $ = s => document.querySelector(s);
const money = n => Number(n || 0).toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
const esc = s => String(s ?? "").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const dateFmt = d => d ? new Date(d).toLocaleDateString("pt-BR") : "—";

async function api(url, options={}) {
  const response = await fetch(url,{
    credentials:"same-origin",
    cache:"no-store",
    ...options,
    headers:{"Content-Type":"application/json",...(options.headers||{})}
  });
  const data = await response.json().catch(()=>({}));
  if(response.status===401) {
    showLogin("Sua sessão expirou. Entre novamente.");
    throw new Error("Sessão não autenticada.");
  }
  if(!response.ok) throw new Error(data.error || "Não foi possível concluir a requisição.");
  return data;
}

function showLogin(message="") {
  $("#app").classList.add("hidden");
  $("#loginScreen").classList.remove("hidden");
  $("#loginError").textContent=message;
}
function showApp() {
  $("#loginScreen").classList.add("hidden");
  $("#app").classList.remove("hidden");
  loadDashboard();
}

$("#loginForm").addEventListener("submit",async event=>{
  event.preventDefault();
  const button=$("#loginButton");
  button.disabled=true;
  $("#loginError").textContent="Verificando acesso…";
  try {
    const result=await fetch("/api/admin/login",{
      method:"POST",credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({username:$("#username").value.trim(),password:$("#password").value})
    });
    const data=await result.json().catch(()=>({}));
    if(!result.ok) throw new Error(data.error||"Usuário ou senha inválidos.");
    const status=await api("/api/admin/status");
    if(!status.authenticated) throw new Error("O servidor não confirmou a sessão.");
    $("#password").value="";
    showApp();
  } catch(error) {
    $("#loginError").textContent=error.message||"Falha ao entrar.";
  } finally {
    button.disabled=false;
  }
});

$("#logoutButton").addEventListener("click",async()=>{
  try { await api("/api/admin/logout",{method:"POST"}); }
  catch {}
  showLogin("Você saiu do painel.");
});

async function checkSession() {
  try {
    const status=await api("/api/admin/status");
    if(status.authenticated) showApp();
    else showLogin();
  } catch {
    showLogin("Não foi possível verificar a sessão. Tente novamente.");
  }
}

async function loadDashboard() {
  try {
    const d=await api("/api/admin/summary");
    $("#revenue").textContent=money(d.revenue);
    $("#salesCount").textContent=d.salesCount ?? 0;
    $("#monthRevenue").textContent=money(d.monthRevenue);
    $("#monthSales").textContent=(d.monthSales ?? 0)+" vendas neste mês";
    $("#lowStock").textContent=d.lowStock ?? 0;
    $("#bestSellers").innerHTML=d.bestSellers?.length
      ? d.bestSellers.map((p,i)=>`<div style="display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)"><span>${i+1}. ${esc(p.name)}</span><b>${Number(p.qty||0)} un.</b></div>`).join("")
      : "Ainda não existem vendas suficientes para mostrar produtos mais vendidos.";
    $("#appMessage").textContent="";
  } catch(e) { $("#appMessage").textContent=e.message; }
}

async function loadProducts() {
  try {
    const products=await api("/api/admin/products");
    $("#productRows").innerHTML=products.map(p=>{
      const photo = p.image || (Array.isArray(p.images) ? p.images[0] : "") || "";
      const safePhoto = esc(photo);
      return `<tr>
        <td><div style="width:58px;height:68px;border-radius:12px;overflow:hidden;background:#202020;border:1px solid var(--line);display:grid;place-items:center">
          ${safePhoto ? `<img src="${safePhoto}" alt="${esc(p.name)}" loading="lazy" style="width:100%;height:100%;object-fit:cover" onerror="this.style.display='none';this.parentElement.innerHTML='<span style=&quot;color:#aaa;font-size:10px&quot;>Sem foto</span>'">` : '<span style="color:#aaa;font-size:10px">Sem foto</span>'}
        </div></td>
        <td><b>${esc(p.name)}</b><br><small class="muted">${esc(p.id)}</small></td>
        <td>${esc(p.category || "—")}</td>
        <td>${p.price==null?"Consultar":money(p.price)}</td>
        <td>${Number(p.stock||0)}</td>
        <td><span class="${p.active?"tag":""}">${p.active?"Ativo":"Oculto"}</span></td>
      </tr>`;
    }).join("")||'<tr><td colspan="6">Nenhum produto encontrado.</td></tr>';
  } catch(e) { $("#productRows").innerHTML=`<tr><td colspan="5">${esc(e.message)}</td></tr>`; }
}

document.querySelectorAll("[data-view]").forEach(button=>button.addEventListener("click",()=>{
  const view=button.dataset.view;
  document.querySelectorAll("[data-view]").forEach(b=>b.classList.toggle("active",b===button));
  ["dashboard","products"].forEach(v=>$("#"+v+"View").classList.toggle("hidden",v!==view));
  $("#pageTitle").textContent=({dashboard:"Visão geral",products:"Produtos"})[view];
  if(view==="dashboard")loadDashboard();
  if(view==="products")loadProducts();
}));
$("#refreshButton").addEventListener("click",()=>{
  const active=document.querySelector("[data-view].active")?.dataset.view||"dashboard";
  if(active==="dashboard")loadDashboard();
  if(active==="products")loadProducts();
});
$("#loadProducts").addEventListener("click",loadProducts);
checkSession();
</script>
</body>
</html>
